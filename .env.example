NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NextStarter"
NEXT_PUBLIC_SITE_META_DESCRIPTION="A modern Next.js boilerplate for building production-ready web applications."

# --- Analytics (optional) ---
# PostHog, configured cookieless in src/instrumentation-client.ts: no cookies,
# no local storage, no consent banner required. Leave the key blank and
# analytics never initializes — the app makes no third-party requests at all.
# Project token from PostHog → Settings → Project → Project API key.
NEXT_PUBLIC_POSTHOG_KEY=""
# EU Cloud by default. Only change this if your PostHog project lives in the US
# region ("https://us.i.posthog.com"), which brings UK→US transfer obligations
# that the EU region does not.
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Upsell / checkout (optional) ---
# Destination for the "Upgrade to Pro" call-to-action on the landing page.
# Point this at your checkout link (e.g. Polar → Products → Checkout Links,
# "https://buy.polar.sh/polar_cl_xxxxx"). Leave blank if you are not selling
# anything.
NEXT_PUBLIC_PRO_URL=""

# --- Post-purchase (/thanks) ---
# Polar redirects buyers to /thanks after checkout. Set this as the "Success URL"
# on the checkout link, optionally with the session id:
#   https://example.com/thanks?checkout_id={CHECKOUT_ID}
# Customer portal for your organization — where buyers sign in with their
# checkout email to claim benefits and get invoices.
# e.g. "https://polar.sh/your-org/portal"
NEXT_PUBLIC_POLAR_PORTAL_URL=""
# Support address shown on /thanks when an order needs help.
# e.g. "support@example.com"
NEXT_PUBLIC_SUPPORT_EMAIL=""

# --- Checkout smoke test (npm run test:checkout) ---
# Only needed to run the on-demand checkout smoke test; the app ignores these.
# The Polar sandbox (https://sandbox.polar.sh) is a fully separate instance:
# its own account, organization, product, benefit, and token. A production
# token will NOT work against it. Leave these blank and the script tells you
# what is missing rather than touching anything live.
POLAR_SANDBOX_TOKEN=""
POLAR_SANDBOX_CHECKOUT_URL=""
# Optional — the sandbox GitHub-repository benefit id, to also assert that
# paying actually granted repo access.
POLAR_SANDBOX_BENEFIT_ID=""
